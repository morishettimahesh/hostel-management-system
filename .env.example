# ==============================================================================
# Hostel Management & Fee Tracking System - Environment Configuration Template
# ==============================================================================
# IMPORTANT SECURITY NOTICE:
# Variables prefixed with VITE_ are embedded into the client-side bundle and are
# PUBLICLY ACCESSIBLE in the browser.
#
# NEVER place database credentials, private API keys, password secrets, or
# sensitive service credentials in frontend environment variables.
# ==============================================================================

# Application Meta
VITE_APP_NAME="Hostel Management & Fee Tracking System"
VITE_APP_VERSION="0.1.0"

# Backend API Configuration (Frontend Client)
VITE_API_BASE_URL="http://localhost:3000/api"
VITE_API_TIMEOUT="15000"
